# MotionFence Environment Configuration Template
# Copy this file to .env and configure for your environment.
# DO NOT commit .env or any secret keys to version control.

# -----------------------------------------------------------------------------
# Core Runtime & Cryptographic Security
# -----------------------------------------------------------------------------
# Runtime environment: 'simulation', 'development', 'testing', or 'production'
# In 'production', MotionFence enforces strict startup security checks.
MOTIONFENCE_ENV=development

# Kernel HMAC secret for signing and validating single-use AuthorizationTickets.
# REQUIRED in production: Must be a random, high-entropy secret >= 32 characters.
# In development: defaults to internal fallback if unset.
MOTIONFENCE_KERNEL_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

# Allowed CORS origin for the MotionFence Judge Console web frontend.
# Local development: http://127.0.0.1:5173 (Vite dev server)
# Production: Set to the exact deployed HTTPS origin (e.g. https://console.example.com).
# In production, wildcard '*' is forbidden. If unset in production, cross-origin requests
# are blocked (same-origin only).
MOTIONFENCE_CORS_ORIGIN=http://127.0.0.1:5173

# Comma-separated list of trusted reverse proxy IP addresses or CIDRs.
# Only proxies in this list are trusted to pass client IP via X-Forwarded-For.
MOTIONFENCE_TRUSTED_PROXIES=

# Explicit test-only flag to permit unverified TLS contexts.
# Strictly forbidden (causes startup refusal) in 'production'.
MOTIONFENCE_ALLOW_INSECURE_TLS=false

# -----------------------------------------------------------------------------
# External Model Providers (Nebius Token Factory / NVIDIA Nemotron)
# -----------------------------------------------------------------------------
# Nebius Token Factory API Key (NVIDIA Nemotron Inference)
NEBIUS_API_KEY=

# Nebius Token Factory OpenAI-compatible Base URL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Model identifier served on Nebius Token Factory
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Request timeout in seconds
NEBIUS_TIMEOUT_SECONDS=30.0

# Optional: Maximum retry attempts for transient errors
NEBIUS_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# External Knowledge Providers (Tavily Search API)
# -----------------------------------------------------------------------------
# Tavily Search API Key (Operational Knowledge & SOP Retrieval)
TAVILY_API_KEY=

# Optional: Tavily request timeout in seconds
TAVILY_TIMEOUT_SECONDS=30.0

# Optional: Maximum results to retrieve
TAVILY_MAX_RESULTS=5
