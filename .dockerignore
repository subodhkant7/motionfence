# MotionFence Docker Ignore Configuration (Phase 2Q)
# Strict exclusion of secrets, environments, caches, test artifacts, and heavy simulation files

# Environment variables & secrets
.env
.env.*
*.env
*.pem
*.key
*.cert
*.secret

# Local virtual environment
.venv
venv/
ENV/
env/

# Source control & editor state
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
*.swo

# Node & frontend development artifacts
console/node_modules
console/dist
console/coverage
console/.vite
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python caches and bytecode
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Test caches & development reports
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
tests/
audit_records/
mutation_records/
.adversarial/
.assurance/
firewall_report.json

# Simulation & GPU artifacts
*.usd
*.usda
*.usdc
isaac_sim/
omniverse/
*.log
scratch/
